{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/Music/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "accept-ranges": "bytes"
      },
      "dest": "/Music/$1"
    },
    {
      "src": "/Pic/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/Pic/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
